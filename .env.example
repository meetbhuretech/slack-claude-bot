# Copy this file to .env and fill in the values you have.
# The practice page works before any of the keys are set.

# --- Where the assistant runs ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATA_DIR=.data
PUBLIC_BASE_URL=http://localhost:3000

# --- The project people will change ---
# Leave this blank to practice on the included sample website.
# Set it to the full path of a git repository to work on a real project.
TARGET_REPO_PATH=
# Branch the assistant branches from. Blank means the repository's current commit.
BASE_BRANCH=

# --- Checks and staging ---
# Used when TARGET_REPO_PATH is set. The sample site has its own commands.
TEST_COMMAND=npm test
# Optional command that prepares the project before checks, such as: npm ci
SETUP_COMMAND=
# Command that publishes the approved branch to staging.
# It runs inside the change's folder. Print the staging link as the last line.
# Example: npm run deploy:staging
DEPLOY_COMMAND=

# --- Approvals ---
# People tap a button before files change, and again before staging updates.
REQUIRE_PLAN_APPROVAL=true
REQUIRE_DEPLOY_APPROVAL=true
# Slack member IDs who may approve anyone's request, comma-separated.
# The person who asked can always approve their own request.
APPROVER_USER_IDS=

# --- Claude ---
# Leave the key blank to use practice mode, which only changes the sample headline.
# Add a key to let Claude Code read and edit the real project.
ANTHROPIC_API_KEY=
CLAUDE_MODE=auto
CLAUDE_MODEL=
CLAUDE_MAX_BUDGET_USD=3
CLAUDE_MAX_TURNS=30
CLAUDE_PHASE_TIMEOUT_MS=600000

# --- Slack ---
# Socket Mode needs both tokens. The app keeps working as a practice page without them.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Safety limits ---
MAX_JOBS_PER_USER_PER_HOUR=8
COMMAND_TIMEOUT_MS=300000
TEST_REPAIR_ATTEMPTS=1
SHOW_TECHNICAL_DETAILS=false

# --- Practice page ---
# In production the practice page stays off unless you set both of these.
SIMULATOR_ENABLED=
ADMIN_TOKEN=
LOG_LEVEL=info
